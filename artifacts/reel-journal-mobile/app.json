{
  "expo": {
    "name": "Reel Journal",
    "slug": "reel-journal-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reel-journal-mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1015"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rogerrari.reeljournal",
      "buildNumber": "1",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.rogerrari.reeljournal"
        ]
      }
    },
    "android": {
      "backgroundColor": "#0F1015"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-share-extension",
        {
          "backgroundColor": "#13151a",
          "height": 380,
          "activationRules": {
            "contentTypes": ["public.url"]
          },
          "appGroupIdentifier": "group.com.rogerrari.reeljournal"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
